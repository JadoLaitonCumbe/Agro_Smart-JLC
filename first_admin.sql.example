INSERT INTO users(tenant_id,name,email,password_hash,role,status) VALUES(@tenant_id,'Administrador','admin@seudominio.co.mz','HASH_GERADO','owner','active');
INSERT INTO farms(tenant_id,name,province,district) VALUES(@tenant_id,'Exploração de demonstração','Maputo','Boane');
